# Postgres connection (Neon pooled URL on Vercel; local: postgres://postgres:postgres@localhost:5432/postgres)
DATABASE_URL=
# Only for the local PGlite server (npm run db:local): DATABASE_POOL_MAX=1

# Vercel Blob token (added automatically when you connect Blob storage in Vercel)
BLOB_READ_WRITE_TOKEN=

# Single admin login
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
